# Shared Hub settings (must match env.pod-a — same broker, encryption key, workspace)
#
# Fleet tracking = shared DB (same H2 ./data + AUTO_SERVER, or later same Postgres URL).
# SPRING_RABBITMQ_ADDRESSES must match pod-a: Worker/inbound + competing consumers.
export SPRING_RABBITMQ_ADDRESSES="amqps://USER:PASS@HOST/VHOST"
export GIT_UTILITY_ENCRYPTION_KEY="replace-with-64-hex-or-32-byte-key"
export GIT_WORKSPACE_DIR="/tmp/git-utility-mirrors-shared"
export GIT_STORAGE_LOCAL_DIR="${GIT_WORKSPACE_DIR}"
export GIT_STORAGE_NAS_DIR="/tmp/git-utility-nas-shared"
export GIT_LFS_DISCOVERY_THREADS=8
# In-job parallelism is per pod and read at startup. Keep each concurrency at or under its pool.
# Rabbit listener max-concurrency caps jobs when the provider is rabbitmq.
# GIT_MESSAGING_NONE_WORKER_THREADS caps jobs when the provider is none (single node).
# export GIT_MESSAGING_NONE_WORKER_THREADS=8
# export GIT_PUSH_BATCH_CONCURRENCY=2
# export GIT_PUSH_BATCH_POOL_MAX_THREADS=8
# export GIT_PUSH_BATCH_PER_HOST_MAX=4
# export GIT_PUSH_BATCH_THROTTLE_COOLDOWN_SECONDS=60
# export GIT_PUSH_BATCH_THROTTLE_COOLDOWN_MAX_SECONDS=1800
# export GIT_PR_CREATE_CONCURRENCY=6
# export GIT_RELEASE_CONCURRENCY=4
# export GIT_LFS_TRANSFER_CONCURRENCY=4

# Must match pod-a (same messaging fabric for the cluster)
# rabbitmq | kafka (reserved) | none — see INSTRUCTIONS.md (use rabbitmq for multi-pod)
export GIT_MESSAGING_PROVIDER=rabbitmq

# Pod B identity (must differ from pod-a)
export GIT_UTILITY_INSTANCE_ID=pod-b
export SERVER_PORT=8081
