# Copy this file to .env in this directory. .env is gitignored.
# npm run dev loads it on your machine. npm run deploy uploads the filled values
# to Cloudflare as secrets. Do not commit .env.
#
# CloudAMQP URL amqps://USER:PASS@HOST/VHOST becomes:
#   RABBITMQ_HTTP_URL=https://HOST
#   RABBITMQ_VHOST=VHOST
#   RABBITMQ_USER=USER
#   RABBITMQ_PASSWORD=PASS

# "true" publishes. "false" keeps the Worker deployed but returns 503.
ENABLED=true

RABBITMQ_HTTP_URL=https://YOUR-INSTANCE.cloudamqp.com
RABBITMQ_VHOST=YOUR_VHOST
RABBITMQ_USER=
RABBITMQ_PASSWORD=

RABBITMQ_EXCHANGE=git.sync.exchange
RABBITMQ_ROUTING_KEY=git.webhook.inbound

# Same string as the GitHub webhook secret. Leave blank if you only use WEBHOOK_SECRETS_JSON.
WEBHOOK_SECRET=

# Optional. Uncomment to set. A blank line is not uploaded.
# WEBHOOK_SECRETS_JSON={"12":"hmac-for-credential-12"}
# BITBUCKET_WEBHOOK_SECRET=
