# Shared Hub settings (copy secrets from your root `env` file)
#
# Fleet tracking (who is alive / leases / job ledger) = shared DB, not Rabbit.
# Local multi-pod: start both JVMs from the same repo-root cwd so they share
# ./data/gitutility with AUTO_SERVER=TRUE (default JDBC URL). Enterprise: Postgres.
# Rabbit below remains required for Edge Worker → inbound + competing consumers.
export SPRING_RABBITMQ_ADDRESSES="amqps://USER:PASS@HOST/VHOST"
export GIT_UTILITY_ENCRYPTION_KEY="replace-with-64-hex-or-32-byte-key"
export GIT_WORKSPACE_DIR="/tmp/git-utility-mirrors-shared"
export GIT_STORAGE_LOCAL_DIR="${GIT_WORKSPACE_DIR}"
export GIT_STORAGE_NAS_DIR="/tmp/git-utility-nas-shared"
export GIT_LFS_DISCOVERY_THREADS=8
export GIT_LFS_DISCOVERY_CONCURRENCY=8

# Messaging fabric (canonical enums — extend this list as adapters ship):
#   rabbitmq  — durable AMQP (CloudAMQP / RabbitMQ). Default. Multi-pod + DLQ.
#   kafka     — reserved; not implemented yet (startup fails fast).
#   none      — in-process, no broker (single-node bring-up only; not for multi-pod).
export GIT_MESSAGING_PROVIDER=rabbitmq

# Pod A identity (must differ from pod-b)
export GIT_UTILITY_INSTANCE_ID=pod-a
export SERVER_PORT=8080
