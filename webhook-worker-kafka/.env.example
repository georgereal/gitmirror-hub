# Copy this file to .env in this directory. .env is gitignored.
# npm run dev loads it on your machine. npm run deploy uploads the filled values
# to Cloudflare as secrets. Do not commit .env.
#
# From the Confluent Cloud cluster overview:
#   KAFKA_REST_ENDPOINT = the REST endpoint, https://, no path
#   KAFKA_CLUSTER_ID    = lkc-...
#   KAFKA_API_KEY / KAFKA_API_SECRET = the cluster API key (shown once)

# "true" produces. "false" keeps the Worker deployed but returns 503.
ENABLED=true

KAFKA_REST_ENDPOINT=https://YOUR-CLUSTER.region.aws.confluent.cloud
KAFKA_CLUSTER_ID=lkc-YOUR_CLUSTER
KAFKA_TOPIC=git.sync.incremental
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Same string as the GitHub webhook secret.
WEBHOOK_SECRET=

# Optional. Uncomment to set. A blank line is not uploaded.
# WEBHOOK_SECRETS_JSON={"12":"hmac-for-credential-12"}
# BITBUCKET_WEBHOOK_SECRET=
